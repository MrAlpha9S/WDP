#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('horsari-backend:server');
var http = require('http');
const { Server } = require('socket.io');
const jwt = require('jsonwebtoken');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Attach Socket.io to the HTTP server.
 * This does NOT affect any existing REST routes.
 */

const io = new Server(server, {
  cors: {
    origin: process.env.FRONTEND_URL || 'http://localhost:5173',
    methods: ['GET', 'POST'],
    credentials: true,
  },
});

// Make `io` accessible in any route/controller via req.app.get('io')
app.set('io', io);

io.on('connection', (socket) => {
  console.log('[WS] client connected:', socket.id);

  // Admin dashboard joins this room to receive admin_notification + admin:events_update.
  // Requires a valid admin JWT passed as socket.auth.token on the client.
  socket.on('join_admin', async ({ token } = {}) => {
    try {
      const raw = (token ?? '').replace(/^Bearer\s+/i, '');
      const payload = jwt.verify(raw, process.env.JWT_SECRET);
      
      const UserRepository = require('../repositories/UserRepository');
      const user = await UserRepository.findById(payload.userId);

      if (!user || user.role !== 'admin') {
        socket.emit('join_admin_error', { msg: 'Forbidden' });
        return;
      }
      socket.join('admin');
      console.log(`[WS] ${socket.id} (uid=${payload.userId}) joined admin room`);
    } catch (err) {
      console.error('[WS] join_admin error:', err.message);
      socket.emit('join_admin_error', { msg: 'Invalid or expired token' });
    }
  });

  // Referee dashboard joins their personal room for targeted notifications.
  // Requires a valid referee JWT passed as { token }.
  socket.on('join_referee', async ({ token } = {}) => {
    try {
      const raw = (token ?? '').replace(/^Bearer\s+/i, '');
      const payload = jwt.verify(raw, process.env.JWT_SECRET);
      
      const UserRepository = require('../repositories/UserRepository');
      const user = await UserRepository.findById(payload.userId);

      if (!user || user.role !== 'referee') {
        socket.emit('join_referee_error', { msg: 'Forbidden' });
        return;
      }
      socket.join(`referee:${payload.userId}`);
      console.log(`[WS] ${socket.id} (uid=${payload.userId}) joined referee room`);
    } catch (err) {
      console.error('[WS] join_referee error:', err.message);
      socket.emit('join_referee_error', { msg: 'Invalid or expired token' });
    }
  });

  // Client joins a specific race room for live simulation events.
  // Requires any valid JWT — spectators, referees, and admins can all watch.
  socket.on('join_race', async ({ raceRoundId, token } = {}) => {
    try {
      const raw = (token ?? '').replace(/^Bearer\s+/i, '');
      const payload = jwt.verify(raw, process.env.JWT_SECRET);
      
      const UserRepository = require('../repositories/UserRepository');
      const user = await UserRepository.findById(payload.userId);

      if (!user || user.status !== 'active') {
        socket.emit('join_race_error', { msg: 'User not found or inactive' });
        return;
      }
      socket.join(`race:${raceRoundId}`);
      console.log(`[WS] ${socket.id} (uid=${payload.userId}) joined race:${raceRoundId}`);
    } catch (err) {
      console.error('[WS] join_race error:', err.message);
      socket.emit('join_race_error', { msg: 'Invalid or expired token' });
    }
  });

  socket.on('disconnect', () => {
    console.log('[WS] client disconnected:', socket.id);
  });
});


/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
