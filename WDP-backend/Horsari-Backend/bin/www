#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('horsari-backend:server');
var http = require('http');
const { Server } = require('socket.io');
const jwt = require('jsonwebtoken');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Attach Socket.io to the HTTP server.
 * This does NOT affect any existing REST routes.
 */

const allowedOrigins = app.get('allowedOrigins');

const io = new Server(server, {
  cors: {
    origin: (origin, cb) => {
      if (!origin || allowedOrigins.includes(origin)) return cb(null, true);
      cb(new Error('Not allowed by CORS'));
    },
    methods: ['GET', 'POST'],
    credentials: true,
  },
});

// Make `io` accessible in any route/controller via req.app.get('io')
app.set('io', io);

// Start the daily scheduler that auto-activates tournaments on their startDate
const { startTournamentScheduler } = require('../services/TournamentScheduler');
startTournamentScheduler(io);

// Watch the raceRound collection so any mutation (status, date, distance,
// livestream URL, etc.) broadcasts live, regardless of which service made it.
const { startRaceRoundChangeStream } = require('../services/RaceRoundChangeStreamService');
startRaceRoundChangeStream(io);

// Same pattern, generalized: watch the base User collection plus every
// per-role extension collection (they share _id with User but live in their
// own collections, not Mongoose discriminators) so any admin-relevant user
// change — status, license verification, profile edits — broadcasts live.
const { startCollectionChangeStream } = require('../services/ChangeStreamService');
const User = require('../entities/User');
const HorseOwner = require('../entities/HorseOwner');
const Jockey = require('../entities/Jockey');
const Referee = require('../entities/Referee');
const Admin = require('../entities/Admin');
const Spectator = require('../entities/Spectator');
const Transaction = require('../entities/Transaction');

[User, HorseOwner, Jockey, Referee, Admin, Spectator].forEach((Model) =>
  startCollectionChangeStream(io, Model, 'user_updated')
);
startCollectionChangeStream(io, Transaction, 'transaction_updated');


io.on('connection', (socket) => {
  console.log('[WS] client connected:', socket.id);

  // Client joins a specific race room for live simulation events.
  // Requires any valid JWT — spectators, referees, and admins can all watch.
  socket.on('join_race', async ({ raceRoundId, token } = {}) => {
    try {
      const raw = (token ?? '').replace(/^Bearer\s+/i, '');
      const payload = jwt.verify(raw, process.env.JWT_SECRET);
      
      const UserRepository = require('../repositories/UserRepository');
      const user = await UserRepository.findById(payload.userId);

      if (!user || user.status !== 'active') {
        socket.emit('join_race_error', { msg: 'User not found or inactive' });
        return;
      }
      socket.join(`race:${raceRoundId}`);
      console.log(`[WS] ${socket.id} (uid=${payload.userId}) joined race:${raceRoundId}`);
    } catch (err) {
      console.error('[WS] join_race error:', err.message);
      socket.emit('join_race_error', { msg: 'Invalid or expired token' });
    }
  });

  // Client joins their own notification room, so NotificationService.notify()
  // can push 'notification_created' events without a race context.
  socket.on('join_user', async ({ token } = {}) => {
    try {
      const raw = (token ?? '').replace(/^Bearer\s+/i, '');
      const payload = jwt.verify(raw, process.env.JWT_SECRET);

      const UserRepository = require('../repositories/UserRepository');
      const user = await UserRepository.findById(payload.userId);

      if (!user || user.status !== 'active') {
        socket.emit('join_user_error', { msg: 'User not found or inactive' });
        return;
      }
      socket.join(`user:${payload.userId}`);
      console.log(`[WS] ${socket.id} (uid=${payload.userId}) joined user:${payload.userId}`);
    } catch (err) {
      console.error('[WS] join_user error:', err.message);
      socket.emit('join_user_error', { msg: 'Invalid or expired token' });
    }
  });

  socket.on('disconnect', () => {
    console.log('[WS] client disconnected:', socket.id);
  });
});


/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
