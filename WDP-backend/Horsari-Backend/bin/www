#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('horsari-backend:server');
var http = require('http');
const { Server } = require('socket.io');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Attach Socket.io to the HTTP server.
 * This does NOT affect any existing REST routes.
 */

const io = new Server(server, {
  cors: {
    origin: process.env.FRONTEND_URL || 'http://localhost:5173',
    methods: ['GET', 'POST'],
    credentials: true,
  },
});

// Make `io` accessible in any route/controller via req.app.get('io')
app.set('io', io);

io.on('connection', (socket) => {
  console.log('[WS] client connected:', socket.id);

  // Client joins a specific race room by raceRoundId
  socket.on('join_race', ({ raceRoundId }) => {
    socket.join(`race:${raceRoundId}`);
    console.log(`[WS] ${socket.id} joined race:${raceRoundId}`);
  });

  socket.on('disconnect', () => {
    console.log('[WS] client disconnected:', socket.id);
  });
});

// ── TEST: broadcast a growing counter every second (referee) ─────────────────
let _testCounter = 0;
setInterval(() => {
  _testCounter++;
  io.emit('test_ping', { count: _testCounter });
}, 1000);

// ── TEST: admin ping counter (independent) ────────────────────────────────────
let _adminCounter = 0;
setInterval(() => {
  _adminCounter++;
  io.emit('admin_ping', { count: _adminCounter });
}, 1000);

// ── TEST: admin_notification — cycles through all types every 5s ──────────────
const _notifTypes = ['race_started', 'race_ended', 'new_registration', 'new_user', 'objection_filed', 'system_alert'];
const _notifTitles = {
  race_started:      'Race Round Started',
  race_ended:        'Race Round Finished',
  new_registration:  'New Registration Submitted',
  new_user:          'New User Joined',
  objection_filed:   'Objection Filed',
  system_alert:      'System Health Check',
};
const _notifMessages = {
  race_started:      'Race #7 — Thunderstrike Classic has gone live.',
  race_ended:        'Race #6 — Golden Cup completed. Results pending.',
  new_registration:  'Horse #14 registered by owner James W.',
  new_user:          'A new referee account has been created.',
  objection_filed:   'Horse #3 objection raised by jockey in Race #6.',
  system_alert:      'All systems operational. DB latency: 12ms.',
};
let _notifIdx = 0;
setInterval(() => {
  const type = _notifTypes[_notifIdx % _notifTypes.length];
  _notifIdx++;
  io.emit('admin_notification', {
    id: Date.now().toString(),
    type,
    title: _notifTitles[type],
    message: _notifMessages[type],
    timestamp: new Date(),
    read: false,
    actionLabel: type === 'system_alert' ? undefined : 'View',
    actionPayload: {},
  });
}, 5000);
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
